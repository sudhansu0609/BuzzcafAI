# Copy to .env and fill in. Nothing here is required to boot -- API keys can
# also be set in the Settings page, which writes backend/config/config.json.

APP_NAME="Buzzcaf AI Studio"
APP_ENV="development"
LOG_LEVEL="INFO"

# --- LLM providers -------------------------------------------------------
# Prefer setting keys here over the JSON config: the API never returns them.
GEMINI_API_KEY=
OPENAI_API_KEY=
# gemini / openai / lm_studio. Unset lets the fallback chain decide.
SELECTED_PROVIDER=
LM_STUDIO_URL=http://localhost:1234/v1

# --- Networking ----------------------------------------------------------
# Ports the launcher uses; must match frontend/vite.config.ts.
FRONTEND_PORT=5173
BACKEND_PORT=8000
# Extra browser origins allowed to call the API, comma-separated.
# ALLOWED_ORIGINS=http://localhost:4173

# --- Data directories ----------------------------------------------------
# Derived from the checkout location by default (backend/core/paths.py).
# Set these only to move data elsewhere, and only to an existing directory.
# PROJECTS_PATH=
# KNOWLEDGE_PATH=
# PROMPTS_PATH=
# LOGS_PATH=

# Copy to .env and fill in. Nothing here is required to boot -- API keys can
# also be set in the Settings page, which writes backend/config/config.json.

APP_NAME="Buzzcaf AI Studio"
APP_ENV="development"
LOG_LEVEL="INFO"

# --- LLM providers -------------------------------------------------------
# Prefer setting keys here over the JSON config: the API never returns them.
GEMINI_API_KEY=
OPENAI_API_KEY=
# gemini / openai / lm_studio. Unset lets the fallback chain decide.
SELECTED_PROVIDER=
LM_STUDIO_URL=http://localhost:1234/v1

# --- Networking ----------------------------------------------------------
# The Studio listens on 127.0.0.1:BUZZCAF_PORT. Default 8099 - 8000 is what
# every other local app picks and the Studio was mistaken for one. If the port
# is busy the launcher steps to the next free one and records the real port in
# backend/config/studio.runtime.json, which Dexter reads.
BUZZCAF_PORT=8099
# --dev only: preferred port for our Vite dev server. 5173 is every Vite's
# default, so if another project's dev server has it the launcher picks the
# next free port and pins Vite to it; the /api proxy follows BUZZCAF_PORT.
BUZZCAF_DEV_PORT=5173
# Extra browser origins allowed to call the API, comma-separated.
# ALLOWED_ORIGINS=http://localhost:4173

# --- Sibling apps ----------------------------------------------------------
# BuzzEdit's backend, for the produce_video bridge (app/api/produce_api.py).
# Usually unnecessary -- resolved automatically via the shared port ledger
# (integrations/buzzcaf_ports.discover), the same way BuzzEdit finds this app.
# Set only to force a specific address.
# BUZZEDIT_URL=http://127.0.0.1:8100

# --- Data directories ----------------------------------------------------
# Derived from the checkout location by default (backend/core/paths.py).
# Set these only to move data elsewhere, and only to an existing directory.
# PROJECTS_PATH=
# KNOWLEDGE_PATH=
# PROMPTS_PATH=
# LOGS_PATH=
